{
  // :not([mini]) because these act on the file. Reached from a find field or a
  // commit box the handlers fall back to the active editor, so they would
  // bookmark the file behind the dialog.
  //
  // Not a bare f2: that is Rename in every editor a user is likely to arrive
  // from, and refactor:rename binds it on this same selector, where the winner
  // is decided by load order alone. tree-view uses f2 for rename too.
  "lumine-text-editor:not([mini])": {
    "alt-f2": "bookmarks:jump-to-next-bookmark",
    "alt-shift-f2": "bookmarks:jump-to-previous-bookmark",
    "ctrl-f2": "bookmarks:toggle-bookmark",
    "ctrl-shift-f2": "bookmarks:clear-bookmarks",
    "ctrl-alt-f2": "bookmarks:view-all"
  }
}
