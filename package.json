{
  "name": "bookmarks",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Mark lines in the editor and jump back to them.",
  "keywords": [
    "marker",
    "jump",
    "navigate",
    "gutter",
    "favorite"
  ],
  "repository": "https://github.com/lumine-code/bookmarks",
  "bugs": {
    "url": "https://github.com/lumine-code/bookmarks/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can bookmark the line under the cursor with {{ 'bookmarks:toggle-bookmark' | keystroke }}",
    "You can search every bookmark you have set with {{ 'bookmarks:view-all' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "bookmarks": {
      "description": "Provides a list of bookmarks to any package that wants to know about them.",
      "versions": {
        "1.0.0": "provideBookmarks"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
